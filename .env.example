# Copy to backend/.env for running the API, worker, or alembic outside docker compose.
# docker compose sets its own values for the containers.

ENV=local
LOG_JSON=false
LOG_LEVEL=INFO

# Local TimescaleDB from docker compose (host port 55432; override with TSDB_HOST_PORT).
# For Tiger Cloud: use the service (or pooler) connection string and set DB_SSL_MODE=require.
DATABASE_URL=postgresql://sugarscout:sugarscout@localhost:55432/sugarscout
DB_SSL_MODE=disable
DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173

# --- Hackathon demo ---------------------------------------------------------------
# Required on deployed environments: protects anything that texts, spends credits,
# or changes state. Leave empty locally to skip the prompt.
DEMO_ACCESS_CODE=
DEMO_CHILD_NAME=Alex
SIM_TICK_SECONDS=5

# Twilio trial: SID, auth token, your trial number, and YOUR verified phone (E.164).
# Leave empty to run SMS in dry-run mode (logged, never sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PARENT_PHONE=

# NVIDIA API catalog key (build.nvidia.com). Empty = chat and summary fall back.
NVIDIA_API_KEY=
NEMOTRON_CHAT_MODEL=nvidia/nemotron-nano-3-30b-a3b
NEMOTRON_ANALYSIS_MODEL=nvidia/nemotron-3-super-120b-a12b
